@@ -0,0 +1,76 @@
+<script setup>
+// IMEP — padrão da conta para a assinatura dos atendentes (posição e separador)
+// e bloqueio da escolha individual. Gravado em accounts.settings.
+import { computed, ref, watch } from 'vue';
+import { useI18n } from 'vue-i18n';
+import { useAlert } from 'dashboard/composables';
+import { useAccount } from 'dashboard/composables/useAccount';
+import { SIGNATURE_POSITION } from 'dashboard/helper/editorHelper';
+import { textoAssinatura } from 'dashboard/helper/imepSignatureTexts';
+import SectionLayout from './SectionLayout.vue';
+
+const { locale } = useI18n();
+const { currentAccount, updateAccount } = useAccount();
+const txt = chave => textoAssinatura(locale.value, chave);
+
+const noComeco = ref(false);
+const separador = ref(true);
+const bloqueado = ref(false);
+
+const settings = computed(() => currentAccount.value?.settings || {});
+watch(
+  settings,
+  s => {
+    noComeco.value = s.signature_position === SIGNATURE_POSITION.START;
+    separador.value = s.signature_delimiter !== false;
+    bloqueado.value = s.signature_locked === true;
+  },
+  { immediate: true }
+);
+
+const salvar = async () => {
+  try {
+    await updateAccount(
+      {
+        signature_position: noComeco.value
+          ? SIGNATURE_POSITION.START
+          : SIGNATURE_POSITION.END,
+        signature_delimiter: separador.value,
+        signature_locked: bloqueado.value,
+      },
+      { silent: true }
+    );
+    useAlert(txt('SALVO'));
+  } catch {
+    useAlert(txt('ERRO'));
+  }
+};
+</script>
+
+<template>
+  <SectionLayout
+    :title="txt('TITULO_CONTA')"
+    :description="txt('NOTA_CONTA')"
+    with-border
+  >
+    <div class="flex flex-col gap-3">
+      <label class="flex items-center gap-2 text-sm">
+        <input v-model="noComeco" type="checkbox" @change="salvar" />
+        {{ txt('NO_COMECO') }}
+      </label>
+      <label class="flex items-center gap-2 text-sm">
+        <input
+          v-model="separador"
+          type="checkbox"
+          :disabled="noComeco"
+          @change="salvar"
+        />
+        {{ txt('SEPARADOR') }}
+      </label>
+      <label class="flex items-center gap-2 text-sm font-medium">
+        <input v-model="bloqueado" type="checkbox" @change="salvar" />
+        {{ txt('BLOQUEAR') }}
+      </label>
+    </div>
+  </SectionLayout>
+</template>
