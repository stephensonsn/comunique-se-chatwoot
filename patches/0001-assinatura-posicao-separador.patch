+<script setup>
+// IMEP — preferência do atendente: assinatura no começo/fim e separador "--".
+// Gravada em ui_settings; se a conta bloquear, vale o padrão da conta.
+import { computed } from 'vue';
+import { useI18n } from 'vue-i18n';
+import { useAlert } from 'dashboard/composables';
+import { useAccount } from 'dashboard/composables/useAccount';
+import { useUISettings } from 'dashboard/composables/useUISettings';
+import {
+  resolveSignatureOptions,
+  SIGNATURE_POSITION,
+} from 'dashboard/helper/editorHelper';
+import { textoAssinatura } from 'dashboard/helper/imepSignatureTexts';
+
+const { locale } = useI18n();
+const { currentAccount } = useAccount();
+const { uiSettings, updateUISettings } = useUISettings();
+
+const txt = chave => textoAssinatura(locale.value, chave);
+const efetivas = computed(() =>
+  resolveSignatureOptions(currentAccount.value?.settings, uiSettings.value)
+);
+const bloqueado = computed(() => efetivas.value.locked);
+const noComeco = computed(
+  () => efetivas.value.position === SIGNATURE_POSITION.START
+);
+
+const salvar = async mudanca => {
+  try {
+    await updateUISettings(mudanca);
+    useAlert(txt('SALVO'));
+  } catch {
+    useAlert(txt('ERRO'));
+  }
+};
+</script>
+
+<template>
+  <div class="flex flex-col gap-3">
+    <div>
+      <p class="text-sm font-medium text-n-slate-12">{{ txt('SECAO') }}</p>
+      <p class="text-sm text-n-slate-11">
+        {{ bloqueado ? txt('BLOQUEADO') : txt('NOTA_PERFIL') }}
+      </p>
+    </div>
+    <label class="flex items-center gap-2 text-sm text-n-slate-12">
+      <input
+        type="checkbox"
+        :checked="noComeco"
+        :disabled="bloqueado"
+        @change="
+          salvar({
+            signature_position: $event.target.checked
+              ? SIGNATURE_POSITION.START
+              : SIGNATURE_POSITION.END,
+          })
+        "
+      />
+      {{ txt('NO_COMECO') }}
+    </label>
+    <label class="flex items-center gap-2 text-sm text-n-slate-12">
+      <input
+        type="checkbox"
+        :checked="efetivas.delimiter"
+        :disabled="bloqueado || noComeco"
+        @change="salvar({ signature_delimiter: $event.target.checked })"
+      />
+      {{ txt('SEPARADOR') }}
+    </label>
+  </div>
+</template>
