+// IMEP — textos da posição/separador da assinatura. Ficam fora dos arquivos de
+// tradução do Chatwoot (que mudam a cada versão) para o patch não conflitar.
+const TEXTOS = {
+  pt_BR: {
+    SECAO: 'Posição da assinatura',
+    NOTA_PERFIL:
+      'Escolha onde a sua assinatura aparece nas mensagens que você envia.',
+    NO_COMECO:
+      'Assinatura no começo da mensagem (ex.: *Seu nome:* e, na linha de baixo, a mensagem)',
+    SEPARADOR: 'Mostrar o separador -- antes da assinatura (quando no fim)',
+    BLOQUEADO: 'Definido pelo administrador da conta.',
+    SALVO: 'Preferência da assinatura salva',
+    ERRO: 'Não foi possível salvar. Tente novamente.',
+    TITULO_CONTA: 'Assinatura das mensagens',
+    NOTA_CONTA:
+      'Padrão da conta para a posição da assinatura dos atendentes. Com o bloqueio, todos seguem este padrão e não podem alterar no perfil.',
+    BLOQUEAR: 'Bloquear alteração pelos atendentes',
+  },
+  en: {
+    SECAO: 'Signature position',
+    NOTA_PERFIL:
+      'Choose where your signature appears in the messages you send.',
+    NO_COMECO:
+      'Signature at the start of the message (e.g. *Your name:* and the message on the next line)',
+    SEPARADOR: 'Show the -- separator before the signature (when at the end)',
+    BLOQUEADO: 'Set by the account administrator.',
+    SALVO: 'Signature preference saved',
+    ERRO: 'Could not save. Please try again.',
+    TITULO_CONTA: 'Message signature',
+    NOTA_CONTA:
+      "Account default for agents' signature position. When locked, everyone follows it and cannot change it in their profile.",
+    BLOQUEAR: 'Lock for agents',
+  },
+};
+
+export const textoAssinatura = (locale, chave) =>
+  (TEXTOS[String(locale || '').startsWith('pt') ? 'pt_BR' : 'en'] || TEXTOS.en)[
+    chave
+  ];
diff --git a/app/javascript/dashboard/helper/specs/editorHelperSignatureImep.spec.js b/app/javascript/dashboard/helper/specs/editorHelperSignatureImep.spec.js
new file mode 100644
index 0000000..9507bc4
--- /dev/null
+++ b/app/javascript/dashboard/helper/specs/editorHelperSignatureImep.spec.js
@@ -0,0 +1,148 @@
+// IMEP — posição (começo/fim) e separador "--" da assinatura.
+import {
+  appendSignature,
+  removeSignature,
+  resolveSignatureOptions,
+  setSignatureOptions,
+  getSignatureOptions,
+  signatureHeader,
+  cleanSignature,
+  SIGNATURE_POSITION,
+} from '../editorHelper';
+
+const START = { position: SIGNATURE_POSITION.START, delimiter: true };
+const END_SEM_TRACO = { position: SIGNATURE_POSITION.END, delimiter: false };
+const ORIGINAL = { position: SIGNATURE_POSITION.END, delimiter: true };
+
+describe('IMEP: assinatura no começo ou no fim, com ou sem --', () => {
+  afterEach(() => setSignatureOptions(null));
+
+  describe('signatureHeader', () => {
+    it('põe os dois-pontos dentro do negrito', () => {
+      expect(signatureHeader('**Stephenson**')).toBe('**Stephenson:**');
+    });
+    it('sem negrito, só acrescenta os dois-pontos', () => {
+      expect(signatureHeader('Stephenson')).toBe('Stephenson:');
+    });
+    it('não duplica os dois-pontos', () => {
+      expect(signatureHeader('**Stephenson:**')).toBe('**Stephenson:**');
+      expect(signatureHeader('Stephenson:')).toBe('Stephenson:');
+    });
+    it('mantém o texto como foi digitado (sem maiúsculas forçadas)', () => {
+      expect(signatureHeader('**Ana Clara**')).toBe('**Ana Clara:**');
+    });
+  });
+
+  describe('appendSignature', () => {
+    it('no começo: cabeçalho num parágrafo próprio e depois a mensagem', () => {
+      expect(appendSignature('Bom dia!', '**Stephenson**', null, START)).toBe(
+        '**Stephenson:**\n\nBom dia!'
+      );
+    });
+    it('no começo com corpo vazio: só o cabeçalho', () => {
+      expect(appendSignature('', '**Stephenson**', null, START)).toBe(
+        '**Stephenson:**\n\n'
+      );
+    });
+    it('no começo: não repete se já está lá', () => {
+      const body = '**Stephenson:**\n\nBom dia!';
+      expect(appendSignature(body, '**Stephenson**', null, START)).toBe(body);
+    });
+    it('no fim sem --', () => {
+      expect(
+        appendSignature('Bom dia!', '**Stephenson**', null, END_SEM_TRACO)
+      ).toBe('Bom dia!\n\n**Stephenson**');
+    });
+    it('padrão continua o original (fim com --)', () => {
+      expect(appendSignature('Bom dia!', '**Stephenson**')).toBe(
+        appendSignature('Bom dia!', '**Stephenson**', null, ORIGINAL)
+      );
+      expect(appendSignature('Bom dia!', '**Stephenson**')).toContain(
+        '--\n\n**Stephenson**'
+      );
+    });
+    it('usa as opções globais definidas pelo painel', () => {
+      setSignatureOptions(START);
+      expect(appendSignature('Oi', '**Stephenson**')).toBe(
+        '**Stephenson:**\n\nOi'
+      );
+    });
+    it('o markdown gerado é estável no editor (parse + serialize)', () => {
+      const body = appendSignature('Bom dia!', '**Stephenson**', null, START);
+      expect(cleanSignature(body)).toBe(body);
+    });
+  });
+
+  describe('removeSignature', () => {
+    it('remove o cabeçalho do começo', () => {
+      expect(
+        removeSignature('**Stephenson:**\n\nBom dia!', '**Stephenson**')
+      ).toBe('Bom dia!');
+    });
+    it('remove a assinatura do fim sem --', () => {
+      expect(
+        removeSignature('Bom dia!\n\n**Stephenson**', '**Stephenson**')
+      ).toBe('Bom dia!');
+    });
+    it('remove a assinatura do fim com -- (comportamento original, mantém as quebras)', () => {
+      const body = appendSignature(
+        'Bom dia!',
+        '**Stephenson**',
+        null,
+        ORIGINAL
+      );
+      expect(removeSignature(body, '**Stephenson**')).toBe('Bom dia!\n\n');
+    });
+    it('trocar de fim para começo com rascunho aberto não duplica', () => {
+      const fim = appendSignature('Bom dia!', '**Stephenson**', null, ORIGINAL);
+      const semAssinatura = removeSignature(fim, '**Stephenson**');
+      expect(
+        appendSignature(semAssinatura, '**Stephenson**', null, START)
+      ).toBe('**Stephenson:**\n\nBom dia!');
+    });
+  });
+
+  describe('resolveSignatureOptions', () => {
+    it('sem nada configurado: original', () => {
+      expect(resolveSignatureOptions(null, null)).toEqual({
+        position: 'end',
+        delimiter: true,
+        locked: false,
+      });
+    });
+    it('atendente escolhe quando a conta não bloqueia', () => {
+      expect(
+        resolveSignatureOptions(
+          { signature_position: 'end' },
+          { signature_position: 'start', signature_delimiter: false }
+        )
+      ).toEqual({ position: 'start', delimiter: false, locked: false });
+    });
+    it('sem escolha do atendente vale o padrão da conta', () => {
+      expect(
+        resolveSignatureOptions(
+          { signature_position: 'start', signature_delimiter: false },
+          {}
+        )
+      ).toEqual({ position: 'start', delimiter: false, locked: false });
+    });
+    it('conta bloqueada ignora a escolha do atendente', () => {
+      expect(
+        resolveSignatureOptions(
+          { signature_position: 'start', signature_locked: true },
+          { signature_position: 'end', signature_delimiter: false }
+        )
+      ).toEqual({ position: 'start', delimiter: true, locked: true });
+    });
+  });
+
+  it('setSignatureOptions(null) volta ao original', () => {
+    setSignatureOptions(START);
+    setSignatureOptions(null);
+    expect(getSignatureOptions()).toEqual({
+      position: 'end',
+      delimiter: true,
+      locked: false,
+    });
+  });
+});
