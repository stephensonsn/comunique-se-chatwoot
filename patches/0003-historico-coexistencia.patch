diff --git a/app/javascript/dashboard/routes/dashboard/settings/inbox/settingsPage/WhatsappHistorySyncStatus.vue b/app/javascript/dashboard/routes/dashboard/settings/inbox/settingsPage/WhatsappHistorySyncStatus.vue
