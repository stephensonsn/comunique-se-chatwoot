diff --git a/lib/tasks/imep_whatsapp_history.rake b/lib/tasks/imep_whatsapp_history.rake
new file mode 100644
index 0000000..7a355e7
--- /dev/null
+++ b/lib/tasks/imep_whatsapp_history.rake
@@ -0,0 +1,21 @@
+# IMEP: comandos de reserva do histórico oficial do WhatsApp (coexistência).
+# A Meta só aceita o pedido em até 24 h depois da conexão de coexistência, uma vez só.
+namespace :imep do
+  namespace :whatsapp_history do
+    desc 'Pede à Meta o histórico do app (smb_app_data sync_type=history) para a caixa INBOX_ID'
+    task :request, [:inbox_id] => :environment do |_task, args|
+      channel = Inbox.find(args.fetch(:inbox_id)).channel
+      raise ArgumentError, 'A caixa não é do WhatsApp Cloud' unless channel.is_a?(Channel::Whatsapp) && channel.provider == 'whatsapp_cloud'
+
+      sync = Whatsapp::HistorySync::RequestService.new(channel).perform
+      puts sync.api_payload.to_json
+    end
+
+    desc 'Mostra o status do histórico da caixa INBOX_ID'
+    task :status, [:inbox_id] => :environment do |_task, args|
+      sync = Inbox.find(args.fetch(:inbox_id)).channel.try(:whatsapp_history_sync)
+      puts(sync ? sync.api_payload.merge(last_error_code: sync.last_error_code, last_error_message: sync.last_error_message,
+                                         events: sync.events.group(:status).count).to_json : 'sem pedido de histórico')
+    end
+  end
+end
