diff --git a/spec/services/whatsapp/history_sync/imep_history_sync_spec.rb b/spec/services/whatsapp/history_sync/imep_history_sync_spec.rb
new file mode 100644
index 0000000..3681015
--- /dev/null
+++ b/spec/services/whatsapp/history_sync/imep_history_sync_spec.rb
@@ -0,0 +1,196 @@
+require 'rails_helper'
+
+# IMEP: histórico oficial do WhatsApp (coexistência) — pedido na reautorização de caixa manual,
+# importação com payloads no formato da documentação da Meta, recusa 2593109 e duplicidade.
+describe 'Histórico do WhatsApp em coexistência (IMEP)' do
+  let(:account) { create(:account) }
+  let(:business_phone) { '+5562999990000' }
+  let(:customer_phone) { '5562988887777' }
+  let(:channel) do
+    create(:channel_whatsapp, account: account, provider: 'whatsapp_cloud', phone_number: business_phone,
+                              provider_config: { 'source' => 'manual_setup_v2' },
+                              validate_provider_config: false, sync_templates: false)
+  end
+  let(:inbox) { channel.inbox }
+  let(:api_client) { instance_double(Whatsapp::FacebookApiClient) }
+
+  def wamid
+    "wamid.imep_#{SecureRandom.hex(10)}"
+  end
+
+  def history_payload(history)
+    {
+      object: 'whatsapp_business_account',
+      entry: [{
+        id: '123456789',
+        changes: [{
+          field: 'history',
+          value: {
+            messaging_product: 'whatsapp',
+            metadata: { display_phone_number: business_phone.delete('+'), phone_number_id: '123456789' },
+            history: history
+          }
+        }]
+      }]
+    }
+  end
+
+  def chunk(messages, phase: 0, chunk_order: 1, progress: 50)
+    [{ metadata: { phase: phase, chunk_order: chunk_order, progress: progress },
+       threads: [{ id: customer_phone, messages: messages }] }]
+  end
+
+  def text_message(from:, body:, timestamp:, id: wamid, status: 'READ')
+    { from: from, id: id, timestamp: timestamp.to_i.to_s, type: 'text', text: { body: body },
+      history_context: { status: status } }
+  end
+
+  def deliver(payload)
+    event = Whatsapp::HistorySync::IngestService.new(channel: channel, params: payload).perform
+    Whatsapp::HistorySyncEventJob.perform_now(event.id)
+    event.reload
+  end
+
+  before do
+    allow(Whatsapp::FacebookApiClient).to receive(:new).and_return(api_client)
+  end
+
+  describe Whatsapp::HistorySync::RequestService do
+    it 'pede o histórico à Meta quando ainda não existe pedido' do
+      expect(api_client).to receive(:request_history_sync).with('123456789').and_return({ 'request_id' => 'req-1' })
+
+      sync = described_class.new(channel).perform
+
+      expect(sync).to be_requested
+      expect(sync.request_id).to eq('req-1')
+    end
+
+    it 'não pede de novo quando o histórico já foi importado' do
+      channel.create_whatsapp_history_sync!(status: :completed, progress: 100)
+      expect(api_client).not_to receive(:request_history_sync)
+
+      expect(described_class.new(channel).perform).to be_completed
+    end
+
+    it 'pede de novo quando o pedido anterior foi recusado (nova conexão)' do
+      channel.create_whatsapp_history_sync!(status: :not_shared, last_error_code: '2593109', progress: 100)
+      expect(api_client).to receive(:request_history_sync).and_return({ 'request_id' => 'req-2' })
+
+      sync = described_class.new(channel).perform
+
+      expect(sync).to be_requested
+      expect(sync.request_id).to eq('req-2')
+      expect(sync.progress).to eq(0)
+      expect(sync.last_error_code).to be_nil
+    end
+  end
+
+  describe Whatsapp::EmbeddedSignupService do
+    let(:params) { { code: 'code', waba_id: '123456789', phone_number_id: '123456789', is_coexistence: true } }
+    let(:service) { described_class.new(account: account, params: params, inbox_id: inbox.id) }
+
+    before do
+      token_exchange = instance_double(Whatsapp::TokenExchangeService, perform: 'token-novo')
+      allow(Whatsapp::TokenExchangeService).to receive(:new).and_return(token_exchange)
+      phone_service = instance_double(Whatsapp::PhoneInfoService,
+                                      perform: { phone_number: business_phone, phone_number_id: '123456789', business_name: 'IMEP' })
+      allow(Whatsapp::PhoneInfoService).to receive(:new).and_return(phone_service)
+      allow_any_instance_of(Channel::Whatsapp).to receive(:setup_webhooks).and_return(true) # rubocop:disable RSpec/AnyInstance
+    end
+
+    it 'pede o histórico ao reconectar pela Meta uma caixa criada por configuração manual' do
+      expect(api_client).to receive(:request_history_sync).with('123456789').and_return({ 'request_id' => 'req-3' })
+
+      result = service.perform
+
+      expect(result.provider_config['source']).to eq('embedded_signup')
+      expect(result.reload.whatsapp_history_sync).to be_requested
+    end
+
+    it 'não pede o histórico quando a reconexão não é de coexistência' do
+      expect(api_client).not_to receive(:request_history_sync)
+
+      described_class.new(account: account, params: params.merge(is_coexistence: false), inbox_id: inbox.id).perform
+    end
+
+    it 'não pede de novo quando o histórico já foi importado' do
+      channel.create_whatsapp_history_sync!(status: :completed, progress: 100)
+      expect(api_client).not_to receive(:request_history_sync)
+
+      service.perform
+    end
+  end
+
+  describe 'importação do webhook history' do
+    let(:base_time) { Time.zone.parse('2026-06-10 09:00:00') }
+
+    before { channel.create_whatsapp_history_sync!(status: :requested, request_id: 'req-1') }
+
+    it 'grava as mensagens no horário original, com a direção certa e a conversa resolvida' do
+      deliver(history_payload(chunk([
+                                      text_message(from: customer_phone, body: 'Bom dia, tem horário?', timestamp: base_time),
+                                      text_message(from: business_phone.delete('+'), body: 'Temos às 14h', timestamp: base_time + 5.minutes)
+                                    ])))
+
+      conversation = inbox.conversations.find_by!(identifier: "whatsapp_history_sync:#{inbox.id}:#{customer_phone}")
+      incoming, outgoing = conversation.messages.order(:created_at).to_a
+
+      expect(conversation).to be_resolved
+      expect(incoming).to be_incoming
+      expect(incoming.content).to eq('Bom dia, tem horário?')
+      expect(incoming.created_at).to eq(base_time)
+      expect(outgoing).to be_outgoing
+      expect(outgoing.content).to eq('Temos às 14h')
+      expect(outgoing.created_at).to eq(base_time + 5.minutes)
+      expect(outgoing.content_attributes).to include('historical' => true, 'external_echo' => true)
+      expect(channel.whatsapp_history_sync.reload.imported_messages).to eq(2)
+    end
+
+    it 'não dispara envio nem webhook de saída (n8n) ao importar' do
+      expect do
+        deliver(history_payload(chunk([text_message(from: business_phone.delete('+'), body: 'Resposta antiga', timestamp: base_time)])))
+      end.not_to have_enqueued_job(SendReplyJob)
+
+      expect(WebhookJob).not_to have_been_enqueued
+    end
+
+    it 'não duplica quando a Meta reenvia o mesmo bloco' do
+      payload = history_payload(chunk([text_message(from: customer_phone, body: 'Oi', timestamp: base_time)]))
+
+      deliver(payload)
+      expect { deliver(payload) }.not_to change(Message, :count)
+    end
+
+    it 'não duplica a mensagem que já entrou pelo echo ao vivo' do
+      id = wamid
+      first = history_payload(chunk([text_message(from: business_phone.delete('+'), body: 'Já entrou', timestamp: base_time, id: id)]))
+      deliver(first)
+
+      again = history_payload(chunk([text_message(from: business_phone.delete('+'), body: 'Já entrou', timestamp: base_time, id: id)],
+                                    chunk_order: 2))
+      expect { deliver(again) }.not_to change(Message, :count)
+    end
+
+    it 'conclui quando o progresso chega a 100 com todos os blocos processados' do
+      deliver(history_payload(chunk([text_message(from: customer_phone, body: 'Fase 0', timestamp: base_time)],
+                                    phase: 0, chunk_order: 1, progress: 40)))
+      deliver(history_payload(chunk([text_message(from: customer_phone, body: 'Fase 2', timestamp: base_time - 90.days)],
+                                    phase: 2, chunk_order: 1, progress: 100)))
+
+      sync = channel.whatsapp_history_sync.reload
+      expect(sync).to be_completed
+      expect(sync.progress).to eq(100)
+      expect(sync.imported_conversations).to eq(1)
+    end
+
+    it 'marca como não compartilhado quando a empresa recusa (erro 2593109)' do
+      deliver(history_payload([{ errors: [{ code: 2_593_109, title: 'History sync is turned off by the business',
+                                            message: 'History sync is turned off by the business' }] }]))
+
+      sync = channel.whatsapp_history_sync.reload
+      expect(sync).to be_not_shared
+      expect(sync.last_error_code).to eq('2593109')
+      expect(Message.where(inbox_id: inbox.id).count).to eq(0)
+    end
+  end
+end
